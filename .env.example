# =============================================================================
# ClaimDesk QA — environment configuration TEMPLATE
# =============================================================================
# Copy this file to `.env` and adjust. `.env` is gitignored and must NEVER be
# committed. In CI these same names are injected from GitHub Actions secrets or
# Jenkins credentials — the framework does not care where the values come from.
#
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
# =============================================================================

# --- environment selector ----------------------------------------------------
# local  : app + database on this machine, tests run on the host (fast inner loop)
# docker : everything inside docker compose, including the test runner
# ci     : headless, artefacts uploaded, no interactive niceties
# staging: a real deployed URL (proves the framework is not hard-wired to Docker)
TEST_ENV=local

# --- application under test ---------------------------------------------------
# BASE_URL is the browser entry point. API_BASE_URL is derived from it when left
# blank, so you normally only set one value.
BASE_URL=http://localhost:8000
API_BASE_URL=

# --- timeouts -----------------------------------------------------------------
# Explicit everywhere. A missing timeout is how a test suite hangs a CI agent.
HTTP_TIMEOUT_SECONDS=15
UI_ACTION_TIMEOUT_MS=10000
UI_NAVIGATION_TIMEOUT_MS=20000

# --- database validation (read-only) ------------------------------------------
# The framework connects with a role that has SELECT and nothing else, so a test
# can observe state but can never mutate it. All writes go through the
# application, exactly as in production. See docs/adr/0003-read-only-db-role.md
#
# Database validation is OPT-IN (the framework default is false, so a fresh clone
# loads with zero configuration). Set it false when running against an environment
# where you have no database access — db-marked tests then SKIP with a reason
# instead of erroring, and the run header says so loudly.
DB_ENABLED=true
DB_HOST=localhost
# 55432 = the disposable project-local cluster created by scripts/local_db.ps1.
# Use 5432 if you point the framework at a PostgreSQL server you manage yourself.
DB_PORT=55432
DB_NAME=claimdesk
DB_USER=claimdesk_qa_ro
DB_PASSWORD=change-me-local-only
DB_CONNECT_TIMEOUT_SECONDS=10

# --- application's own database account (used by the app, not by tests) -------
# Only needed when you run the ClaimDesk application locally or in compose.
APP_DB_USER=claimdesk_app
APP_DB_PASSWORD=change-me-local-only
APP_JWT_SECRET=change-me-local-only-not-a-real-secret
APP_JWT_EXPIRY_MINUTES=60

# --- seeded test accounts -----------------------------------------------------
# Deliberately obvious dummy credentials for a throwaway local database.
# They are documented, not hidden, because pretending they are secret would be
# security theatre. Real environments inject real values from a secret store.
SEED_USER_PASSWORD=Passw0rd!seed

# --- execution / diagnostics --------------------------------------------------
HEADLESS=true
LOG_LEVEL=INFO
ARTIFACTS_DIR=artifacts
# Fix the Faker seed to make a "random data" failure reproducible. Leave blank
# for a per-run seed, which is printed in the report so you can pin it later.
FAKER_SEED=
