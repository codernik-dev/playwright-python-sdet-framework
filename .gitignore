# --- secrets (NEVER commit) -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- test output ------------------------------------------------------------
# One gitignored root instead of four half-empty folders: one thing to ignore,
# one thing to archive in CI, one thing to delete. See docs/phase-1-design.md §16.
artifacts/
allure-results/
allure-report/
.allure/
*.junit.xml

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- playwright -------------------------------------------------------------
test-results/
playwright-report/
.playwright/

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
