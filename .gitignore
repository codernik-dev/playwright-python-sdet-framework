# --- secrets (NEVER commit) -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- local disposable database cluster -------------------------------------
.pgdata/

# --- test output ------------------------------------------------------------
# One gitignored root instead of four half-empty folders: one thing to ignore,
# one thing to archive in CI, one thing to delete. See docs/phase-1-design.md §16.
artifacts/
allure-results/
allure-report/
.allure/
# `junit*.xml`, not `*.junit.xml`. The original pattern required a dot before
# the word, so it matched `results.junit.xml` and never matched `junit.xml` -
# which is exactly what --junitxml=junit.xml produces, and exactly what got
# committed by accident in Phase 8. Caught by running pre-commit for the first
# time; a near-miss glob is worse than no glob, because it looks handled.
junit*.xml
*.junit.xml

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- playwright -------------------------------------------------------------
test-results/
playwright-report/
.playwright/

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
